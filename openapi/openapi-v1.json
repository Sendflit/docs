  "components": {
    "schemas": {
      "AttachmentIn": {
        "properties": {
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "content_b64": {
            "type": "string",
            "title": "Content B64"
          },
          "content_type": {
            "type": "string",
            "title": "Content Type",
            "default": "application/octet-stream"
          }
        },
        "type": "object",
        "required": [
          "filename",
          "content_b64"
        ],
        "title": "AttachmentIn"
      },
      "BatchIn": {
        "properties": {
          "emails": {
            "items": {
              "$ref": "#/components/schemas/app__api__SendIn"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Emails"
          }
        },
        "type": "object",
        "required": [
          "emails"
        ],
        "title": "BatchIn"
      },
      "DomainIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "return_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Return Path"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "DomainIn"
      },
      "DomainPatch": {
        "properties": {
          "return_path": {
            "type": "string",
            "title": "Return Path"
          }
        },
        "type": "object",
        "required": [
          "return_path"
        ],
        "title": "DomainPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "KeyIn": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "default": "default"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": "full"
          },
          "policy": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy"
          }
        },
        "type": "object",
        "title": "KeyIn"
      },
      "KeyPatch": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "policy": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy"
          }
        },
        "type": "object",
        "title": "KeyPatch"
      },
      "SuppressionIn": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "default": "unsubscribe"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "SuppressionIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
