    "/v1/email": {
      "post": {
        "summary": "Send",
        "description": "Send one email. Pass an `Idempotency-Key` header on retry-sensitive\ncalls: retrying the exact same request with the same key replays the\noriginal result (including a prior failure) instead of sending twice. Reusing the key with a different body is rejected as a client error.",
        "operationId": "send_v1_email_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/app__api__SendIn"
              }
            }
          }
        },
        "responses": {
